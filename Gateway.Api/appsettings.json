{
  "ReverseProxy": {
    "Routes": {
      "rooms": {
        "ClusterId": "rooms",
        "Match": { "Path": "/api/rooms/{**catch-all}" }
      },
      "requests": {
        "ClusterId": "requests",
        "Match": { "Path": "/api/requests/{**catch-all}" }
      },
      "bookings": {
        "ClusterId": "bookings",
        "Match": { "Path": "/api/bookings/{**catch-all}" }
      },
      "reports": {
        "ClusterId": "reports",
        "Match": { "Path": "/api/reports/{**catch-all}" }
      }
    },
    "Clusters": {
      "rooms": { "Destinations": { "d1": { "Address": "https://localhost:7041" } } },
      "requests": { "Destinations": { "d1": { "Address": "https://localhost:7042" } } },
      "bookings": { "Destinations": { "d1": { "Address": "https://localhost:7043" } } },
      "reports": { "Destinations": { "d1": { "Address": "https://localhost:7044" } } }
    }
  }
}
